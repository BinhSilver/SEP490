    {
     "order": 4,
     "speaker": "近所の人",
     "ja": "そう。中をゆすいで、つぶさずにね。",
     "vi": "Đúng. Tráng bên trong, và đừng bóp bẹp nhé."
    },
    {
     "order": 5,
     "speaker": "リン",
     "ja": "古い椅子はどうすればいいですか。",
     "vi": "Cái ghế cũ thì làm thế nào ạ?"
    },
    {
     "order": 6,
     "speaker": "近所の人",
     "ja": "あれは粗大ごみ。市役所に申し込んで、シールを買うの。",
     "vi": "Cái đó là rác cồng kềnh. Đăng ký với thành phố rồi mua tem."
    },
    {
     "order": 7,
     "speaker": "リン",
     "ja": "手続きが要るんですね。教えてくださってありがとうございます。",
     "vi": "Phải làm thủ tục nhỉ. Cảm ơn cô đã chỉ cho cháu."
    }
