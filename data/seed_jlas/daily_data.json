   "situation_vi": "Xem phòng và hỏi về chi phí ban đầu.",
   "lines": [
    {
     "order": 1,
     "speaker": "リン",
     "ja": "初期費用は全部でいくらになりますか。",
     "vi": "Chi phí ban đầu tổng cộng là bao nhiêu ạ?"
    },
    {
     "order": 2,
     "speaker": "不動産",
     "ja": "家賃、敷金一か月、礼金なしで、合計十四万円ほどです。",
     "vi": "Tiền thuê, đặt cọc một tháng, không tiền lễ, tổng khoảng mười bốn vạn ạ."
    },
    {
     "order": 3,
     "speaker": "リン",
     "ja": "礼金がないのは助かります。共益費は別ですか。",
     "vi": "Không có tiền lễ thì đỡ quá. Phí quản lý tính riêng ạ?"
    },
    {
     "order": 4,
     "speaker": "不動産",
     "ja": "はい、月三千円が別途かかります。",
     "vi": "Vâng, mỗi tháng thêm ba nghìn yên ạ."
    },
    {
     "order": 5,
     "speaker": "リン",
     "ja": "日当たりはどうですか。",
     "vi": "Phòng có nắng không ạ?"
    },
    {
     "order": 6,
     "speaker": "不動産",
     "ja": "南向きですので、昼間は明るいですよ。",
     "vi": "Hướng nam nên ban ngày sáng lắm ạ."
    },
    {
     "order": 7,
     "speaker": "リン",
     "ja": "騒音は気になりませんか。",
     "vi": "Có ồn không ạ?"
    },
    {
     "order": 8,
     "speaker": "不動産",
     "ja": "大通りから離れていますので、静かなほうです。",
     "vi": "Xa đường lớn nên thuộc loại yên tĩnh ạ."
    }
   ],
   "key_phrases": [
    {
     "ja": "〜は別ですか",
