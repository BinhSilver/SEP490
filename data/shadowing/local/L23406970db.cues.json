[
  {
    "order": 1,
    "start": 10.84,
    "end": 12.12,
    "text": "マジでいる。",
    "furigana": "マジでいる。",
    "translation": "Cô ấy thật sự đang ở đây.",
    "translation_source": "EDITOR_AUTHORED",
    "caption_source": "LOCAL_WHISPER_CROSSCHECK"
  },
  {
    "order": 2,
    "start": 12.12,
    "end": 13.94,
    "text": "ど、どうも。",
    "furigana": "ど、どうも。",
    "translation": "Chào… chào bạn.",
    "translation_source": "EDITOR_AUTHORED",
    "caption_source": "LOCAL_WHISPER_CROSSCHECK"
  },
  {
    "order": 3,
    "start": 18.1,
    "end": 20.88,
    "text": "昨日は……。",
    "furigana": "昨日(きのう) は……。",
    "translation": "Chuyện hôm qua…",
    "translation_source": "EDITOR_AUTHORED",
    "caption_source": "LOCAL_WHISPER_CROSSCHECK"
  },
  {
    "order": 4,
    "start": 23.12,
    "end": 26.36,
    "text": "あの……。",
    "furigana": "あの……。",
    "translation": "À…",
    "translation_source": "EDITOR_AUTHORED",
    "caption_source": "LOCAL_WHISPER_CROSSCHECK",
    "review_note": "Đuôi câu chưa xác định chắc; dấu … biểu thị phần lược bỏ, không dùng làm dẫn chứng câu hỏi.",
    "requires_audio_review": true
  },
  {
    "order": 5,
    "start": 43.38,
    "end": 47.2,
    "text": "いや、なんだこれ。自分ちで、自分ちのケーキを、年下に……。",
    "furigana": "いや、なんだこれ。 自(じ) 分ち(わかち) で、 自(じ) 分ち(わかち) のケーキを、 年下(としした) に……。",
    "translation": "Khoan, chuyện gì thế này? Ngay ở nhà mình, lại được một người nhỏ tuổi hơn mời bánh của nhà mình…",
    "translation_source": "EDITOR_AUTHORED",
    "caption_source": "LOCAL_WHISPER_CROSSCHECK"
  },
  {
    "order": 6,
    "start": 47.72,
    "end": 52.94,
    "text": "あの、昨日はいきなり飛び出してしまって、すみませんでした。",
    "furigana": "あの、 昨日(きのう) はいきなり 飛び出し(とびだし) てしまって、すみませんでした。",
    "translation": "À, tôi xin lỗi vì hôm qua đã đột ngột chạy ra ngoài.",
    "translation_source": "EDITOR_AUTHORED",
    "caption_source": "LOCAL_WHISPER_CROSSCHECK"
  },
  {
    "order": 7,
    "start": 54.66,
    "end": 57.2,
    "text": "そのケーキはお詫びなので、食べてください。",
    "furigana": "そのケーキはお 詫び(わび) なので、 食べ(たべ) てください。",
    "translation": "Chiếc bánh đó là để xin lỗi, nên bạn hãy ăn nhé.",
    "translation_source": "EDITOR_AUTHORED",
    "caption_source": "LOCAL_WHISPER_CROSSCHECK"
  },
  {
    "order": 8,
    "start": 58.2,
    "end": 59,
    "text": "あ、いや。",
    "furigana": "あ、いや。",
    "translation": "À, không…",
    "translation_source": "EDITOR_AUTHORED",
    "caption_source": "LOCAL_WHISPER_CROSSCHECK"
  },
  {
    "order": 9,
    "start": 60.24,
    "end": 61.54,
    "text": "そういうわけには……。",
    "furigana": "そういうわけには……。",
    "translation": "Tôi không thể nhận như vậy được…",
    "translation_source": "EDITOR_AUTHORED",
    "caption_source": "LOCAL_WHISPER_CROSSCHECK"
  },
  {
    "order": 10,
    "start": 67.26,
    "end": 68.38,
    "text": "どうぞ。",
    "furigana": "どうぞ。",
    "translation": "Mời bạn.",
    "translation_source": "EDITOR_AUTHORED",
    "caption_source": "LOCAL_WHISPER_CROSSCHECK"
  },
  {
    "order": 11,
    "start": 69.18,
    "end": 71.1,
    "text": "いや、それはあなたに……。",
    "furigana": "いや、それはあなたに……。",
    "translation": "Không, cái đó là để dành cho bạn…",
    "translation_source": "EDITOR_AUTHORED",
    "caption_source": "LOCAL_WHISPER_CROSSCHECK"
  },
  {
    "order": 12,
    "start": 71.98,
    "end": 73.02,
    "text": "いいんすよ。",
    "furigana": "いいんすよ。",
    "translation": "Không sao đâu.",
    "translation_source": "EDITOR_AUTHORED",
    "caption_source": "LOCAL_WHISPER_CROSSCHECK"
  },
  {
    "order": 13,
    "start": 73.92,
    "end": 75.24,
    "text": "これ、うまいんで。",
    "furigana": "これ、うまいんで。",
    "translation": "Bánh này ngon lắm.",
    "translation_source": "EDITOR_AUTHORED",
    "caption_source": "LOCAL_WHISPER_CROSSCHECK"
  },
  {
    "order": 14,
    "start": 75.24,
    "end": 76.52,
    "text": "よかったら。",
    "furigana": "よかったら。",
    "translation": "Nếu bạn muốn thì cứ ăn nhé.",
    "translation_source": "EDITOR_AUTHORED",
    "caption_source": "LOCAL_WHISPER_CROSSCHECK"
  },
  {
    "order": 15,
    "start": 77.9,
    "end": 78.46,
    "text": "でも……。",
    "furigana": "でも……。",
    "translation": "Nhưng…",
    "translation_source": "EDITOR_AUTHORED",
    "caption_source": "LOCAL_WHISPER_CROSSCHECK"
  },
  {
    "order": 16,
    "start": 86.08,
    "end": 87.48,
    "text": "すみません。",
    "furigana": "すみません。",
    "translation": "Cảm ơn, làm phiền bạn rồi.",
    "translation_source": "EDITOR_AUTHORED",
    "caption_source": "LOCAL_WHISPER_CROSSCHECK"
  },
  {
    "order": 17,
    "start": 88.12,
    "end": 88.96,
    "text": "いただきます。",
    "furigana": "いただきます。",
    "translation": "Tôi xin phép ăn nhé.",
    "translation_source": "EDITOR_AUTHORED",
    "caption_source": "LOCAL_WHISPER_CROSSCHECK"
  },
  {
    "order": 18,
    "start": 88.96,
    "end": 89.74,
    "text": "はい。",
    "furigana": "はい。",
    "translation": "Vâng.",
    "translation_source": "EDITOR_AUTHORED",
    "caption_source": "LOCAL_WHISPER_CROSSCHECK"
  },
  {
    "order": 19,
    "start": 90.68,
    "end": 95.98,
    "text": "ケーキもだけど、食べることが好きなんだな、この子。",
    "furigana": "ケーキもだけど、 食べる(たべる) ことが 好き(すき) なんだな、この 子(こ) 。",
    "translation": "Không chỉ thích bánh, cô bé này có vẻ rất thích ăn uống.",
    "translation_source": "EDITOR_AUTHORED",
    "caption_source": "LOCAL_WHISPER_CROSSCHECK"
  },
  {
    "order": 20,
    "start": 96.92,
    "end": 97.34,
    "text": "あ。",
    "furigana": "あ。",
    "translation": "À.",
    "translation_source": "EDITOR_AUTHORED",
